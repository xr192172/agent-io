  "task_plan": {
    "note": "★ 这份 JSON 本身 = 讨论桌：每一条'该做什么'都写成了六种 kind 的可判期望。",
    "invariants": [
      "任务 = 意图 ⇒ 住设计侧；实际侧只有事实",
      "只落意图与事件，不落读数快照、不落校验结果",
      "一处权威 + 一处渲染（同一批数据不许两处都存）",
      "设计侧不复制事实（能由 DB 现算的字段不许落盘）",
      "★ 前态判据（edge-absent 一类）不得用作「已满足」的判据"
    ],
    "state_machine": {
      "states": [
        "candidate",
        "claimed",
        "done",
        "void",
        "superseded"
      ],
      "transitions": [
        {
          "from": "candidate",
          "to": "claimed",
          "guard": "canClaim: 剔除前态判据后未必全过 && target 存在 && CAS(owner)"
        },
        {
          "from": "candidate",
          "to": "void",
          "guard": "target 在 DB 里已不存在（★ 与『已满足』是两种不同结局）"
        },
        {
          "from": "claimed",
          "to": "candidate",
          "guard": "显式 release || now - claimed_at > TTL"
        },
        {
          "from": "candidate|claimed",
          "to": "done",
          "guard": "judgeExpectations 全过 && validateProgressEvidence 过"
        },
        {
          "from": "candidate",
          "to": "superseded",
          "guard": "新卡 replaces: <old_id>"
        }
      ]
    },
    "patrols": [
      {
        "id": "lease_ttl",
        "red": "state=claimed && now-claimed_at>TTL && 无 release 事件 的卡数 > 0"
      },
      {
        "id": "drift",
        "red": "候选且(剔前态后)全过（漏收口） 或 target 从 DB 消失（应转 void） 的卡数 > 0"
      },
      {
        "id": "dual_write",
        "red": "overlay 与设计侧同名卡数 > 0 且任一边 updated_at 晚于另一边 ⇒ 权威不明"
      }
    ],
    "migration_order": [
      "设计侧落地",
      "读端切过去(读不到回退 overlay)",
      "测回退",
      "才退 overlay"
    ],
    "open_questions": [
      "『已满足』的卡：自动收口(标 done) 还是只提示？—— 用户尚未拍",
      "TTL 取值",
      "void 的卡是否留档",
      "discussion 版本链要不要可 diff（讨论本身进对拍？）"
    ]
  }
}
