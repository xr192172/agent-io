{
  "name": "agent-io",
  "version": "0.1.3",
  "description": "人机共享的可视化协议层。LLM 输出结构化 DSL JSON → 协作前端渲染成可交互图 → 人看图改 JSON → LLM 读 JSON 迭代。本仓库是数据/协议层，可视化由独立前端承载，内置精简渲染器仅作预览兜底。作为 MCP 服务对外开放。",
  "license": "MIT",
  "type": "module",
  "author": "xr192172",
  "homepage": "https://github.com/xr192172/agent-io#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xr192172/agent-io.git"
  },
  "bugs": {
    "url": "https://github.com/xr192172/agent-io/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "visualization",
    "dsl",
    "llm",
    "code-refactoring",
    "code-understanding",
    "tree-sitter",
    "brick",
    "ai-agent"
  ],
  "engines": {
    "node": ">=22.5"
  },
  "files": [
    "dist/src/presentation/mcp/server.js",
    "dist/src/**/*.js",
    "schema/*.json",
    "examples/*.json",
    "assets/*.png",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "bin": {
    "agent-io": "dist/src/presentation/mcp/server.js"
  },
  "scripts": {
    "build": "node scripts/gen_agents.mjs && tsc && node scripts/clean_dist.mjs",
    "verify": "node scripts/verify.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "node dist/src/presentation/mcp/server.js",
    "serve": "node dist/src/presentation/http/serve.js",
    "daemon": "node dist/src/presentation/daemon/daemon.js",
    "instrument": "node dist/src/presentation/cli/cli.js observe_instrument",
    "setup": "node scripts/setup.mjs",
    "doctor": "node scripts/setup.mjs --doctor",
    "rebuild": "node scripts/rebuild_feature.mjs",
    "translate": "node dist/src/presentation/cli/cli.js translate_go_ts",
    "dogfood": "node dist/src/infrastructure/dogfood_stats.js",
    "brickify": "node dist/src/presentation/cli/brickify_cli.js",
    "signal-review": "node dist/src/presentation/cli/cli.js signal_review",
    "split-stage": "node dist/src/presentation/cli/cli.js split_stage",
    "deprecate-offline": "node dist/src/presentation/cli/cli.js deprecate_offline",
    "capability": "node dist/src/presentation/cli/cli.js capability_audit",
    "install-package": "node dist/src/presentation/cli/install_package_cli.js",
    "diagnose": "node dist/src/presentation/cli/cli.js diagnose",
    "diagnose-loop": "node dist/src/presentation/cli/diagnose_loop_cli.js",
    "hub": "node scripts/hub.mjs",
    "demo": "node scripts/demo.mjs",
    "gen:schema": "node scripts/gen_endpoints_schema.mjs",
    "structure:gap": "node scripts/structure_gap.mjs",
    "lang:check": "node scripts/check_lang_pkgs.mjs",
    "net:probe": "node scripts/net_probe.mjs",
    "mcp:install": "node scripts/install_mcp.mjs",
    "mcp:check": "node scripts/install_mcp.mjs --check",
    "tool": "node dist/src/presentation/cli/cli.js",
    "grammar:list": "node scripts/grammar_shim.mjs list",
    "grammar:build": "node scripts/grammar_shim.mjs build",
    "grammar:build-all": "node scripts/grammar_shim.mjs build-all",
    "grammar:pins": "node scripts/grammar_shim.mjs pins",
    "grammar:verify": "node scripts/verify_grammar_rebuild.mjs",
    "roster:merge": "python scripts/merge_language_roster.py",
    "roster:diff": "python scripts/diff_language_rosters.py",
    "grammar:freeze": "python scripts/freeze_grammar_sources.py",
    "grammar:verify-frozen": "node scripts/grammar_shim.mjs verify-frozen",
    "probe:extract": "node scripts/probe_extract_quality.mjs",
    "probe:extract-hard": "node scripts/probe_extract_hard.mjs",
    "probe:xfile": "node scripts/probe_xfile_resolve.mjs",
    "probe:closure": "node scripts/probe_closure_multi.mjs",
    "probe:impact": "node scripts/probe_impact_reverse.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.1",
    "ignore": "^7.0.6",
    "tree-sitter": "^0.21.1",
    "tree-sitter-javascript": "^0.21.4",
    "tree-sitter-typescript": "^0.21.2",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "optionalDependencies": {
    "agent-io-grammar-crystal": "file:vendor/grammars/crystal",
    "agent-io-grammar-fish": "file:vendor/grammars/fish",
    "agent-io-grammar-ocaml": "file:vendor/grammars/ocaml",
    "agent-io-grammar-r": "file:vendor/grammars/r",
    "agent-io-grammar-swift": "file:vendor/grammars/swift",
    "agent-io-grammar-toml": "file:vendor/grammars/toml",
    "agent-io-grammar-vhdl": "file:vendor/grammars/vhdl",
    "agent-io-grammar-vue": "file:vendor/grammars/vue",
    "tree-sitter-bash": "^0.21.0",
    "tree-sitter-c": "^0.21.0",
    "tree-sitter-c-sharp": "^0.21.3",
    "tree-sitter-clojure": "^0.4.0",
    "tree-sitter-cpp": "^0.23.4",
    "tree-sitter-css": "^0.21.0",
    "tree-sitter-cue": "^0.0.1",
    "tree-sitter-dart": "^1.0.0",
    "tree-sitter-elixir": "^0.3.5",
    "tree-sitter-go": "^0.21.2",
    "tree-sitter-graphql": "^1.0.0",
    "tree-sitter-groovy": "^0.1.2",
    "tree-sitter-haskell": "^0.23.1",
    "tree-sitter-html": "^0.23.2",
    "tree-sitter-java": "^0.23.5",
    "tree-sitter-json": "^0.24.8",
    "tree-sitter-julia": "^0.23.1",
    "tree-sitter-kotlin": "^0.3.8",
    "tree-sitter-latex": "^0.0.0",
    "tree-sitter-lua": "^2.1.3",
    "tree-sitter-markdown": "^0.7.1",
    "tree-sitter-php": "^0.23.12",
    "tree-sitter-python": "^0.21.0",
    "tree-sitter-ruby": "^0.23.1",
    "tree-sitter-rust": "^0.21.0",
    "tree-sitter-scala": "^0.24.0",
    "tree-sitter-scheme": "^1.0.0",
    "tree-sitter-scss": "^1.0.0",
    "tree-sitter-solidity": "1.2.11",
    "tree-sitter-sql": "^0.1.0",
    "tree-sitter-toml": "^0.5.1",
    "tree-sitter-verilog": "^1.0.0",
    "tree-sitter-vue": "^0.2.1",
    "tree-sitter-xml": "^1.0.0",
    "tree-sitter-yaml": "^0.5.0",
    "tree-sitter-zig": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.4.0"
  }
}
